# =====================================================
# Trinetra - Environment Configuration
# =====================================================

APP_NAME=Trinetra
APP_VERSION=0.1.0
ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=INFO

HOST=127.0.0.1
PORT=8000

AI_PROVIDER=groq

GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_FALLBACK_MODEL=llama-3.1-8b-instant

AI_REQUEST_TIMEOUT=30
AI_MAX_RETRIES=3

MONGO_URI=
MONGO_DB_NAME=trinetra

REDIS_URL=

JWT_SECRET=
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60

FRAME_SKIP=2

YOLO_MODEL=yolov8n.pt
YOLO_CONFIDENCE=0.50
YOLO_IOU=0.45

MOG_HISTORY=500
MOG_VAR_THRESHOLD=16
MOG_DETECT_SHADOWS=true

WEBSOCKET_HOST=0.0.0.0
WEBSOCKET_PORT=8765

UPLOAD_DIR=uploads
LOG_DIR=logs

TIMEZONE=Asia/Kolkata
